# Copy this file to `.env` in the same folder and fill in your real values.
# `.env` is gitignored -- never commit real keys/passwords.

# --- API-Football ---
# api_provider: "direct" (v3.football.api-sports.io, api-football.com account)
#           or "rapidapi" (api-football-v1.p.rapidapi.com, RapidAPI account)
API_PROVIDER=direct
API_FOOTBALL_KEY=your_api_key_here
API_TIMEZONE=Europe/London

# --- Run behaviour ---
LOOKAHEAD_DAYS=7
MIN_GAMES_PLAYED=5
RECENT_FORM_GAMES=5
# How many historical matches per team to pull match-events for (checks 12/13).
# Keep this small -- it is one extra API call per match per team.
TIMING_LOOKBACK_GAMES=10
MIN_TIMING_SAMPLE=5
# Comma-separated league names or ids to restrict to for a cheap sanity-check
# run, e.g. "Premier League,39". Leave empty for worldwide scope.
LEAGUE_WHITELIST=Premier League
# checks_passed threshold that counts as a "high score" match in the email summary
HIGH_SCORE_THRESHOLD=10

# --- Rate limiting / caching ---
REQUESTS_PER_MINUTE=60
CACHE_TTL_HOURS=12
FETCH_XG=true
FETCH_INJURIES=true

# --- Output ---
# Windows path, e.g. C:\Users\kdalt\Desktop\Football Bets
OUTPUT_DIR=C:\Users\kdalt\Desktop\Football Bets
LOG_DIR=.

# --- Email ---
SEND_EMAIL=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GMAIL_ADDRESS=your_gmail_address@gmail.com
# Generate at https://myaccount.google.com/apppasswords -- NOT your normal password.
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_TO=kdalts@googlemail.com

# Copy this file to .env and fill in real values. Never commit .env.

# Sportmonks Football API token (required).
# Get one at https://www.sportmonks.com/football-api/
SPORTMONKS_API_TOKEN=

# Optional overrides (defaults shown)
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
SPORTMONKS_TIMEOUT_SECONDS=15
SPORTMONKS_MAX_RETRIES=5
SPORTMONKS_BACKOFF_BASE_SECONDS=1.0
SPORTMONKS_REQUESTS_PER_MINUTE=60

# Database (required)
# Local dev example: postgresql+psycopg://postgres:postgres@localhost:5432/football_platform
DATABASE_URL=
DATABASE_ECHO=false

# API / frontend
# Comma-separated origins allowed to call the read API (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:3000
